# Credentials for `docker compose`. Copy to `.env` and change what matters.
#
#   cp .env.example .env && docker compose up -d
#
# `.env` is gitignored; this file is not. The defaults here are the same obvious
# throwaways the compose file falls back to, and they are deliberately published:
# a stack that runs with a documented password cannot be mistaken for one that is
# secure, whereas a "changeme" that never gets changed is a credential nobody
# knows is a credential.

# -- postgres ---------------------------------------------------------------
POSTGRES_PASSWORD=toolmarket-local

# -- ports ------------------------------------------------------------------
API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=toolmarket-local

# -- tuning (optional; compose sets these already) --------------------------
# Writes per window, per client. The limiter is in-process, so N replicas allow
# N x this — see toolmarket/ratelimit.py, which says so where it matters.
RATE_LIMIT=120
RATE_LIMIT_WINDOW=60
# Seconds. 0 disables the read cache entirely.
CACHE_TTL=30

# -- retrieval / embedding (required for the dense leg) ----------------------
# Without a key the dense (vector) leg is skipped and /search ranks on BM25
# alone: hit@5 .893 and hit@1 .607 instead of .955 / .777 (toolmarket/retrieval.py).
# /search reports the legs it actually used in `mode`, so a missing key is
# visible as mode="bm25" rather than as "retrieval feels worse".
# EMBED_BASE_URL=https://aiping.cn/api/v1
# EMBED_API_KEY=                     # OpenAI-compatible embedding key
# EMBED_MODEL=Qwen3-Embedding-0.6B   # multilingual, 1024 dims
# EMBED_DIM=1024
# EMBED_CONFIG=                      # alt: an autoforge config.json carrying api_key
# EMBED_TIMEOUT=20
# EMBED_BATCH=32

# -- listwise rerank fallback (optional) ------------------------------------
# When the cross-encoder reranker is unreachable, a chat model can order what
# BM25 already found (toolmarket/llm_rerank.py); off unless LLM_RERANK=1.
# LLM_RERANK_BASE_URL=http://127.0.0.1:8788/v1
# LLM_RERANK_API_KEY=
# LLM_RERANK_MODEL=deepseek-v4.1-flash
